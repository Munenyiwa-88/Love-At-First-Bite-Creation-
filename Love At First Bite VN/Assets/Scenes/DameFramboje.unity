  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  raspberryDialogueText: {fileID: 1632056502}
  playerDialogueText: {fileID: 2027155241}
  nextButton: {fileID: 1514928728}
  nextPlayerButton: {fileID: 0}
  goodEndButton: {fileID: 1513123937}
  badEndButton: {fileID: 1410061695}
